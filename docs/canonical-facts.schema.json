{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cxx-modgraph.dev/schema/dependency-facts-v4.json",
  "title": "cxx-modgraph dependency facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source-root",
    "translation-units",
    "external-modules"
  ],
  "properties": {
    "version": {
      "enum": [1, 2, 3, 4]
    },
    "source-root": {
      "type": "string",
      "minLength": 1
    },
    "translation-units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "object",
          "provides",
          "requires"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "type": "string"
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "bmi"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "bmi": {
                  "type": "string",
                  "minLength": 1
                },
                "is-interface": {"type":"boolean"},
                "lookup-method": {"type":"string"}
              }
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependency-reasons": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["module","reason","lookup-method"],"properties":{"module":{"type":"string"},"reason":{"type":"string"},"lookup-method":{"type":"string"},"raw-requirement":{"type":"string"}}}},
          "provenance": {"type":"object","additionalProperties":false,"properties":{"rule-source":{"type":"string"},"scanner":{"type":"string"},"scanner-version":{"type":"string"},"original-output":{"type":"string"},"source-lookup":{"type":"string"},"source-path-unique":{"type":"boolean"},"raw-rule":{"type":"string"}}},
          "arguments": {"type":"array","items":{"type":"string"}},
          "local-arguments": {"type":"array","items":{"type":"string"}},
          "work-directory": {"type":"string"},
          "module-set": {"type":"string","minLength":1},
          "private": {"type":"boolean"},
          "bmi-compatibility": {"$ref":"#/$defs/bmi-compatibility"}
        }
      }
    },
    "external-modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bmi"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bmi": {
            "type": "string",
            "minLength": 1
          },
          "module-set": {"type":"string","minLength":1},
          "bmi-compatibility": {"$ref":"#/$defs/bmi-compatibility"}
        }
      }
    },
    "inputs": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","digest"],"properties":{"path":{"type":"string"},"digest":{"type":"string","pattern":"^fnv1a64:[0-9a-f]{16}$"}}}},
    "module-sets": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","family-name","baseline-arguments"],"properties":{"name":{"type":"string","minLength":1},"family-name":{"type":"string"},"baseline-arguments":{"type":"array","items":{"type":"string"}},"visible-sets":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}}},
    "bmi-cache": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["module","source-digest","recipe-digest","compatibility-key","bmi-digest"],"properties":{"module":{"type":"string","minLength":1},"module-set":{"type":"string","minLength":1},"source-digest":{"type":"string","minLength":1},"recipe-digest":{"type":"string","minLength":1},"compatibility-key":{"type":"string","minLength":1},"bmi-digest":{"type":"string","minLength":1},"object-digest":{"type":"string"}}}}
  },
  "$defs": {
    "bmi-compatibility": {"type":"object","additionalProperties":false,"properties":{"compiler-executable":{"type":"string"},"compiler-version":{"type":"string"},"target-triple":{"type":"string"},"sysroot":{"type":"string"},"language-standard":{"type":"string"},"standard-library":{"type":"string"},"configuration":{"type":"string","minLength":1},"user-key":{"type":"string"},"adapter-keys":{"type":"array","items":{"type":"string"}}}}
  }
}
